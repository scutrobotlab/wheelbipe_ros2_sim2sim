<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>keyboard_teleop</name>
  <version>0.1.0</version>
  <description>Keyboard teleoperation for WheelBipe motion, height, and controller state.</description>
  <maintainer email="2231625449@qq.com">SCUTRobotLab</maintainer>
  <license>MIT</license>
  <url type="website">https://www.scutbot.cn/</url>
  <author>SCUTRobotLab</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
