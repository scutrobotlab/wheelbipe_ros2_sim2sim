<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- MuJoCo actuator response shared by the four leg drive joints. -->
  <xacro:property name="v14_actuator_model_enabled" value="true"/>
  <xacro:property name="v14_actuator_time_constant_s" value="0.014"/>
  <xacro:property name="v14_actuator_transport_delay_s" value="0.0"/>
  <xacro:property name="v14_actuator_dc_gain" value="1.0"/>
  <xacro:property name="v14_actuator_natural_frequency_hz" value="50.0"/>
  <xacro:property name="v14_actuator_damping_ratio" value="0.10"/>
  <xacro:property name="v14_actuator_torque_slew_rate_nm_s" value="1500.0"/>
  <xacro:property name="v14_actuator_output_limit" value="54.0"/>
  <xacro:property name="v14_actuator_speed_droop_start_rad_s" value="4.0"/>
  <xacro:property name="v14_actuator_speed_droop_per_rad_s" value="0.055"/>
  <xacro:property name="v14_actuator_min_speed_gain" value="0.55"/>

  <xacro:macro name="ros2control" params="name backend='sim' serial_port='/dev/wheelbipe_h7' baudrate='2000000' serial_reconnect_interval_ms='1000' state_timeout_ms='100'">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${backend == 'sim'}">
          <plugin>mujoco_ros2_control/MujocoSystem</plugin>
          <param name="gas_spring_model_enabled">true</param>
          <param name="gas_spring_q_min">-0.005</param>
          <param name="gas_spring_q_max">0.07</param>
          <param name="gas_spring_force_at_q_min">650.0</param>
          <param name="gas_spring_force_at_q_max">450.0</param>
          <param name="gas_spring_manual_passive_enabled">true</param>
          <param name="gas_spring_manual_viscous_damping">500.0</param>
          <param name="gas_spring_manual_static_friction">0.0</param>
          <param name="gas_spring_manual_velocity_epsilon">0.01</param>
        </xacro:if>
        <xacro:if value="${backend == 'real'}">
          <plugin>template_real_ros2_ctrl::RealBridge</plugin>
          <param name="serial_port">${serial_port}</param>
          <param name="baudrate">${baudrate}</param>
          <param name="serial_reconnect_interval_ms">${serial_reconnect_interval_ms}</param>
          <param name="state_timeout_ms">${state_timeout_ms}</param>
        </xacro:if>
      </hardware>

      <joint name="left_front1_joint">
        <param name="actuator_model_enabled">${v14_actuator_model_enabled}</param>
        <param name="actuator_time_constant_s">${v14_actuator_time_constant_s}</param>
        <param name="actuator_transport_delay_s">${v14_actuator_transport_delay_s}</param>
        <param name="actuator_dc_gain">${v14_actuator_dc_gain}</param>
        <param name="actuator_natural_frequency_hz">${v14_actuator_natural_frequency_hz}</param>
        <param name="actuator_damping_ratio">${v14_actuator_damping_ratio}</param>
        <param name="actuator_torque_slew_rate_nm_s">${v14_actuator_torque_slew_rate_nm_s}</param>
        <param name="actuator_output_limit">${v14_actuator_output_limit}</param>
        <param name="actuator_speed_droop_start_rad_s">${v14_actuator_speed_droop_start_rad_s}</param>
        <param name="actuator_speed_droop_per_rad_s">${v14_actuator_speed_droop_per_rad_s}</param>
        <param name="actuator_min_speed_gain">${v14_actuator_min_speed_gain}</param>
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"><param name="min">-54</param><param name="max">54</param></command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="left_rear1_joint">
        <param name="actuator_model_enabled">${v14_actuator_model_enabled}</param>
        <param name="actuator_time_constant_s">${v14_actuator_time_constant_s}</param>
        <param name="actuator_transport_delay_s">${v14_actuator_transport_delay_s}</param>
        <param name="actuator_dc_gain">${v14_actuator_dc_gain}</param>
        <param name="actuator_natural_frequency_hz">${v14_actuator_natural_frequency_hz}</param>
        <param name="actuator_damping_ratio">${v14_actuator_damping_ratio}</param>
        <param name="actuator_torque_slew_rate_nm_s">${v14_actuator_torque_slew_rate_nm_s}</param>
        <param name="actuator_output_limit">${v14_actuator_output_limit}</param>
        <param name="actuator_speed_droop_start_rad_s">${v14_actuator_speed_droop_start_rad_s}</param>
        <param name="actuator_speed_droop_per_rad_s">${v14_actuator_speed_droop_per_rad_s}</param>
        <param name="actuator_min_speed_gain">${v14_actuator_min_speed_gain}</param>
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"><param name="min">-54</param><param name="max">54</param></command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="right_front1_joint">
        <param name="actuator_model_enabled">${v14_actuator_model_enabled}</param>
        <param name="actuator_time_constant_s">${v14_actuator_time_constant_s}</param>
        <param name="actuator_transport_delay_s">${v14_actuator_transport_delay_s}</param>
        <param name="actuator_dc_gain">${v14_actuator_dc_gain}</param>
        <param name="actuator_natural_frequency_hz">${v14_actuator_natural_frequency_hz}</param>
        <param name="actuator_damping_ratio">${v14_actuator_damping_ratio}</param>
        <param name="actuator_torque_slew_rate_nm_s">${v14_actuator_torque_slew_rate_nm_s}</param>
        <param name="actuator_output_limit">${v14_actuator_output_limit}</param>
        <param name="actuator_speed_droop_start_rad_s">${v14_actuator_speed_droop_start_rad_s}</param>
        <param name="actuator_speed_droop_per_rad_s">${v14_actuator_speed_droop_per_rad_s}</param>
        <param name="actuator_min_speed_gain">${v14_actuator_min_speed_gain}</param>
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"><param name="min">-54</param><param name="max">54</param></command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="right_rear1_joint">
        <param name="actuator_model_enabled">${v14_actuator_model_enabled}</param>
        <param name="actuator_time_constant_s">${v14_actuator_time_constant_s}</param>
        <param name="actuator_transport_delay_s">${v14_actuator_transport_delay_s}</param>
        <param name="actuator_dc_gain">${v14_actuator_dc_gain}</param>
        <param name="actuator_natural_frequency_hz">${v14_actuator_natural_frequency_hz}</param>
        <param name="actuator_damping_ratio">${v14_actuator_damping_ratio}</param>
        <param name="actuator_torque_slew_rate_nm_s">${v14_actuator_torque_slew_rate_nm_s}</param>
        <param name="actuator_output_limit">${v14_actuator_output_limit}</param>
        <param name="actuator_speed_droop_start_rad_s">${v14_actuator_speed_droop_start_rad_s}</param>
        <param name="actuator_speed_droop_per_rad_s">${v14_actuator_speed_droop_per_rad_s}</param>
        <param name="actuator_min_speed_gain">${v14_actuator_min_speed_gain}</param>
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"><param name="min">-54</param><param name="max">54</param></command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="left_wheel_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"><param name="min">-5</param><param name="max">5</param></command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="right_wheel_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"><param name="min">-5</param><param name="max">5</param></command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="left_spring2_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"><param name="min">-10000.0</param><param name="max">10000.0</param></command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="right_spring2_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"><param name="min">-10000.0</param><param name="max">10000.0</param></command_interface>
        <command_interface name="kp"/>
        <command_interface name="kd"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <sensor name="imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
      <xacro:if value="${backend == 'real'}">
        <sensor name="dt7">
          <state_interface name="cmd_state"/>
          <state_interface name="cmd_vel_x"/>
          <state_interface name="cmd_omega_z"/>
          <state_interface name="cmd_height"/>
        </sensor>
      </xacro:if>
    </ros2_control>
  </xacro:macro>

</robot>
